# ================================
# UniTide Environment Variables
# ================================
# Copy this file to .env (or .env.local) and fill in real values.
# In Next.js, variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Never put secrets in NEXT_PUBLIC_ variables.

# 1) Runtime mode
# What it is:
#   Controls production/development behavior.
# How to set:
#   development for local dev, production for deployed environments.
NODE_ENV=development

# 2) App metadata
# What it is:
#   Human-readable app info used by your config.
# How to set:
#   Any values you want to display internally.
APP_NAME="UniTide Admin Panel"
APP_VERSION="1.0.0"

# 3) Public site URL
# What it is:
#   Canonical site URL used for metadata/open graph in production.
# How to get it:
#   Use your deployed domain, e.g. https://app.yourdomain.com
#   On Vercel, this is your production domain.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 4) MongoDB URI
# What it is:
#   Connection string for your MongoDB database.
# How to get it:
#   MongoDB Atlas -> Database -> Connect -> Drivers -> copy URI
#   or local MongoDB URI (mongodb://127.0.0.1:27017/unitide)
MONGODB_URI="mongodb://127.0.0.1:27017/unitide"

# 5) JWT secrets
# What it is:
#   Secrets used to sign/verify access and refresh tokens.
# How to get it:
#   Generate long random strings (at least 64 chars). Example:
#   openssl rand -base64 64
# Security notes:
#   - Must be different values.
#   - Never commit real secrets.
JWT_ACCESS_SECRET="replace-with-64-plus-char-random-access-secret"
JWT_REFRESH_SECRET="replace-with-64-plus-char-random-refresh-secret"

# 6) Token timeout values (seconds)
# What it is:
#   Access token and refresh token max age in seconds.
# Defaults in app:
#   ACCESS_TIMEOUT=300 (5 min), REFRESH_TIMEOUT=864000 (10 days)
# How to set:
#   Keep defaults unless you have security/compliance requirements.
ACCESS_TIMEOUT="300"
REFRESH_TIMEOUT="864000"

# 7) Supabase values
# What it is:
#   - NEXT_PUBLIC_SUPABASE_URL: your Supabase project URL (safe for client use)
#   - SUPABASE_SECRET_KEY: Supabase service role key (server secret)
# How to get it:
#   Supabase Dashboard -> Project Settings -> API
#   - Project URL -> NEXT_PUBLIC_SUPABASE_URL
#   - service_role key -> SUPABASE_SECRET_KEY
# Security notes:
#   - service_role key bypasses RLS; keep it strictly server-side.
#   - Never expose service_role key to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SECRET_KEY="your-supabase-service-role-key"
